rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticación y autorización
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().get('role', 'user') == 'admin')
      );
    }

    function isInWorkspace(workspaceId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().get('workspaceId', '') == workspaceId)
      );
    }

    // ==========================================
    // Colección: users
    // ==========================================
    match /users/{userId} {
      // Lectura permitida si el usuario es el dueño o es un administrador
      allow read: if isOwner(userId) || isAdmin();

      // Creación: permitida al auto-registrarse (rol: user, tipo: free, billingExempt: false) o por admin
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('accountType', 'free') == 'free' &&
        request.resource.data.get('billingExempt', false) == false &&
        request.resource.data.get('workspaceId', userId) == userId
      );

      // Modificación: un usuario NO puede auto-ascender a admin ni cambiar su plan/billingExempt/workspaceId
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.get('accountType', 'free') == resource.data.get('accountType', 'free') &&
        request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free') &&
        request.resource.data.get('billingExempt', false) == resource.data.get('billingExempt', false) &&
        request.resource.data.get('workspaceId', userId) == resource.data.get('workspaceId', userId)
      );

      // Eliminación reservada exclusivamente para administradores
      allow delete: if isAdmin();
    }

    // ==========================================
    // Colección: workspaces y sus subcolecciones
    // ==========================================
    match /workspaces/{workspaceId} {
      // El abogado titular o el administrador pueden leer y gestionar el workspace
      allow read: if isInWorkspace(workspaceId);
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == workspaceId);
      allow update, delete: if isAdmin() || isInWorkspace(workspaceId);

      // Subcolecciones aisladas de causas jurídicas (clientes, casos, eventos, pagos, etc.)
      match /{document=**} {
        allow read, write: if isInWorkspace(workspaceId);
      }
    }

    // Denegar cualquier otra colección no definida explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
