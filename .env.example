# Copiar a .env.local y usar la configuración de la aplicación WEB de Firebase.
# Estas variables se incluyen en el navegador; no usar cuentas de servicio ni claves Admin.
# Completar estos valores prepara los servicios, pero NO migra datos ni cambia el repositorio local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
